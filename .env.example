# Copy to .env in the repo root. Never commit .env.

# --- required ---
# SQLite is enough to boot the API locally without MySQL or Docker.
DATABASE_URL=sqlite:///./rafdi.db
SECRET_KEY=replace-with-a-long-random-string

# MySQL (local install or Docker). If set, this is what Compose uses for the API container.
# DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/rafdi

# --- optional: password-reset email (Resend) ---
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev

# --- Docker Compose only ---
MYSQL_ROOT_PASSWORD=replace-me
MYSQL_DATABASE=rafdi
